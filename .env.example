# ─── Supabase Configuration (Frontend - Safe public keys) ──────────────────────
# Found in Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# ─── Razorpay Key ID (Frontend - Public Key ID ONLY) ──────────────────────────
# Found in Razorpay Dashboard → Settings → API Keys (rzp_test_... or rzp_live_...)
# NEVER put RAZORPAY_KEY_SECRET here!
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Leave blank when using Docker/Nginx reverse proxy or same domain (uses /api)
# Set to custom URL (e.g. https://api.yourdomain.com) if backend is hosted separately
VITE_BACKEND_URL=

# ─── YouTube Official Channel Integration (Optional) ─────────────────────────
VITE_YOUTUBE_API_KEY=
VITE_YOUTUBE_CHANNEL_ID=UCn46HBkf6RSZTV9tj3cqVBg
